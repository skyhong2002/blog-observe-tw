[Unit]
Description=blog.observe.tw web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/deck/.t3/projects/blog-observe-tw
ExecStart=/home/deck/.local/bin/node /home/deck/.t3/projects/blog-observe-tw/server.mjs
EnvironmentFile=-/home/deck/.config/blog-observe.env
Environment=NODE_ENV=production
Environment=PORT=18160
Environment=HOSTNAME=127.0.0.1
Restart=always
RestartSec=3
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target
