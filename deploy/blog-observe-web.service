[Unit]
Description=blog.observe.tw Next.js web
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.t3/projects/blog-observe-tw/web/.next/standalone/web
EnvironmentFile=-%h/.config/blog-observe-web.env
Environment=NODE_ENV=production
ExecStart=%h/.local/bin/node server.js --hostname 127.0.0.1 --port 18162
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
