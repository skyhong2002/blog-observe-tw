PORT=18160
HOSTNAME=127.0.0.1
BLOG_PUBLIC_ORIGIN=https://weblog.tw
BLOG_DB_URL=mysql://blog_observe:password@127.0.0.1:13306/blog_observe
BLOG_REDIS_URL=redis://127.0.0.1:17379
BLOG_GOOGLE_CLIENT_ID=
BLOG_GOOGLE_CLIENT_SECRET=
BLOG_SESSION_SECRET=replace-with-at-least-32-random-characters
BLOG_UI_ORIGIN=http://127.0.0.1:18162
BLOG_QUEUE_NAME=blog-observe-crawl
BLOG_QUEUE_PREFIX=blog-observe
BLOG_SIMILARWEB_ENABLED=false

# Bounded, resumable background batches (user-authorized automatic RSS collection).
BLOG_HISTORY_ENABLED=true
BLOG_CANDIDATE_REVIEW_ENABLED=true
BLOG_MISSING_FAVICONS_ENABLED=true
# Generated scrapers for feedless homes and broken feeds (docs/generated-scrapers.md). Requires bwrap.
BLOG_SCRAPER_GENERATION_ENABLED=false
# BLOG_SCRAPER_BWRAP=/usr/bin/bwrap

# Only these verified Google emails may bootstrap a permanent sub pin. Removing an email revokes effective admin access.
# Never delete identity pins when revoking; use tools/admin-role.ts USER_ID reader NOTE.
BLOG_ADMIN_EMAILS=

# Offline-only new topic normalization. Production keeps the published legacy namespace.
BLOG_TOPIC_FORMAT_NORMALIZATION_ENABLED=false
