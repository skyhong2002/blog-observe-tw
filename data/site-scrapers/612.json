    "code": "function listPosts({url,$}) {return {posts:$(\"a[href*=\\\"/posts/\\\"]\").map((i,e)=>({url:$(e).attr('href'),title:$(e).text().trim(),publishedAt:$(e).closest('li,article').find('time').attr('datetime')})).get(),next:null};}\nfunction parsePost({url,$}) {const title=$(\"h1\").first().text().trim();const body=$(\"#quarto-document-content\").first().clone();body.find('script,style,nav,aside,footer,.toc,.table-of-contents,.post-tags,.post-meta,.blog-post-title,.title,.upvote-button,.embedded.blog-posts').remove();return {title,bodyHtml:body.html()||'',author:$('meta[name=\"author\"]').attr('content')||null,publishedAt:$('meta[property=\"article:published_time\"]').attr('content')||$('time[datetime]').first().attr('datetime')||$('meta[name=\"date\"]').attr('content')||null,tags:$('a[rel=\"tag\"]').map((i,e)=>$(e).text().trim()).get()};}",
    "render": false,
