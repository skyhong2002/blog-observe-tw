{
  "version": 1,
  "blogId": 560,
  "home": "https://blog.liyenting.com/",
  "authoredBy": "gpt-6.1-sol",
  "scraper": {
    "listUrls": [
      "https://blog.liyenting.com/"
    ],
    "maxPages": 1,
    "code": "function listPosts({url,$}) {return {posts:$(\".post-entry a.entry-link\").map((_,e)=>({url:$(e).attr('href'),title:$(e).text().trim()})).get(),next:null};}\nfunction parsePost({url,$}) {const body=$(\".post-content\").first().clone();body.find(\"script,style,nav,header,footer,.upvote,.embedded.blog-posts\").remove();return {title:$(\"h1.post-title\").first().text().trim(),bodyHtml:body.html()||'',author:$('meta[name=\"author\"]').attr('content')||null,publishedAt:$('time[datetime]').first().attr('datetime')||$('meta[property=\"article:published_time\"]').attr('content')||null,tags:[]};}",
    "render": false,
    "noArticles": false,
    "needsRender": false,
    "notes": "PaperMod post-entry 的 entry-link 列表，文章 post-content。"
  }
}
