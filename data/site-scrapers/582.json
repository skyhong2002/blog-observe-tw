{
  "version": 1,
  "blogId": 582,
  "home": "https://chen.info/",
  "authoredBy": "gpt-6.1-sol",
  "scraper": {
    "listUrls": [
      "https://chen.info/"
    ],
    "maxPages": 1,
    "code": "function listPosts({url,$}) {return {posts:$(\"article h4.title a\").toArray().map(e=>({url:$(e).attr('href'),title:$(e).text().trim()})),next:null};}\nfunction parsePost({url,$}) {const body=$(\"article.single\").first().clone();body.find('script,style,nav,header,footer,.post-nav,.subscribe-widget,.subscription-widget,.post-bottom').remove();return {title:$(\"h1\").first().text().trim(),bodyHtml:body.html()||'',author:$('meta[name=\"author\"]').attr('content')||null,publishedAt:$('meta[property=\"article:published_time\"]').attr('content')||$('time').first().attr('datetime')||null,tags:[]};}",
    "render": false,
    "noArticles": false,
    "needsRender": false,
    "notes": "實際檢視首頁、文章列表與文章HTML；正文容器 article.single。"
  }
}
