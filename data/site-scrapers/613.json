    "code": "function listPosts({url,$}) {return {posts:$(\".post-list a.post\").map((_,e)=>({url:$(e).attr('href'),title:$(e).text().trim()})).get(),next:null};}\nfunction parsePost({url,$}) {const body=$(\"article.prose\").first().clone();body.find(\"script,style,header\").remove();return {title:$(\"h1\").first().text().trim(),bodyHtml:body.html()||'',author:$('meta[name=\"author\"]').attr('content')||null,publishedAt:$('time[datetime]').first().attr('datetime')||$('meta[property=\"article:published_time\"]').attr('content')||null,tags:[]};}",
    "render": false,
    "noArticles": false,
    "needsRender": false,
    "notes": "首頁 .post-list a.post 連到文章；文章 article.prose。"
  }
