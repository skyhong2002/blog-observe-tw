[Unit]
Description=blog.observe.tw BullMQ worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.t3/projects/blog-observe-tw
EnvironmentFile=-%h/.config/blog-observe.env
Environment=NODE_ENV=production
Environment=BLOG_QUEUE_NAME=blog-observe-crawl
Environment=BLOG_QUEUE_PREFIX=blog-observe
ExecStart=%h/.local/bin/node app/src/worker.ts
Restart=always
RestartSec=10
TimeoutStopSec=600
NoNewPrivileges=true
Nice=10
CPUQuota=35%
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=default.target
