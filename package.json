{
  "name": "blog-observe-tw",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env app/src/server.js",
    "dev": "node --watch --env-file-if-exists=.env app/src/server.js",
    "worker": "node --env-file-if-exists=.env app/src/worker.ts",
    "test": "npx vitest run",
    "typecheck": "npx tsc -p tsconfig.json && npx tsc -p web/tsconfig.json",
    "lint": "npx biome check .",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "node tools/migrate-drizzle.mjs",
    "crawl:once": "node --env-file-if-exists=.env tools/crawl-once.ts",
    "seed:import": "node tools/import-seeds.mjs",
    "feed:once": "node tools/crawl-feeds.mjs",
    "discover:blogblog": "node --env-file-if-exists=.env tools/discover-blogblog.ts",
    "discover:similar": "node --env-file-if-exists=.env tools/discover-similar.ts",
    "web:build": "npm --prefix web run build",
    "web:start": "npm --prefix web run start"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/reply-from": "^12.6.5",
    "bullmq": "^6.3.9",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.4",
    "pino": "^10.3.1",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
