{
  "name": "blog-observe-tw",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env app/src/server.js",
    "dev": "node --watch --env-file-if-exists=.env app/src/server.js",
    "worker": "node --env-file-if-exists=.env app/src/worker.ts",
    "test": "npx vitest run",
    "typecheck": "npx tsc -p tsconfig.json && npx tsc -p web/tsconfig.json",
    "lint": "npx biome check .",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "node tools/migrate-drizzle.mjs",
    "crawl:once": "node --env-file-if-exists=.env tools/crawl-once.ts",
    "seed:import": "node tools/import-seeds.mjs",
    "feed:once": "node --env-file-if-exists=.env tools/crawl-once.ts",
    "discover:blogblog": "node --env-file-if-exists=.env tools/discover-blogblog.ts",
    "discover:similar": "node --env-file-if-exists=.env tools/discover-similar.ts",
    "web:build": "node tools/build-web.mjs",
    "web:start": "npm --prefix web run start",
    "blogs:merge": "node --env-file-if-exists=.env tools/merge-blog-urls.ts",
    "favicons:fetch": "node --env-file-if-exists=.env tools/fetch-favicons.ts",
    "seed:resolve": "node --env-file-if-exists=.env tools/resolve-seed-urls.ts",
    "history:batch": "node --env-file-if-exists=.env tools/crawl-history.ts",
    "candidates:review": "node --env-file-if-exists=.env tools/review-candidates.ts",
    "relations:once": "node --env-file-if-exists=.env tools/relations-once.ts",
    "ai:once": "node --env-file-if-exists=.env tools/ai-once.ts",
    "topics:once": "node --env-file-if-exists=.env tools/topics-once.ts",
    "vocabulary:sync": "node --env-file-if-exists=.env tools/topics-once.ts --sync",
    "audit:topic-writers": "node tools/audit-topic-writers.ts",
    "test:integration": "node tools/test-integration.mjs",
    "test:visibility": "node tools/test-visibility-barrier.mjs",
    "content:once": "node --env-file-if-exists=.env tools/content-once.ts",
    "test:web": "node --test web/test/*.test.ts",
    "test:topic-ui": "npx vitest run --config vitest.topic-ui.config.ts",
    "docs:api": "node tools/gen-api-docs.ts",
    "docs:api:check": "node tools/gen-api-docs.ts --check",
    "api:check": "node tools/check-openapi.ts",
    "topics:display-audit": "node --env-file-if-exists=.env tools/audit-topic-display.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/reply-from": "^12.6.5",
    "bullmq": "^6.3.9",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.4",
    "pino": "^10.3.1",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
